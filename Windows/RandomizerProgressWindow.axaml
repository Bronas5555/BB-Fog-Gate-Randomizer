<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="200"
        x:Class="BB_Fog_Gate_Randomizer.Windows.RandomizerProgressWindow"
        Title="Randomizing"
        Width="350"
        Height="200"
        CanResize="False">
    <Grid
        RowDefinitions="*, Auto">
        <Grid
            Grid.Row="0"
            RowDefinitions="Auto, *, Auto">
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="24"
                Grid.Row="0"
                Text="Randomizing..."></TextBlock>
            <Border
                Grid.Row="1"
                BorderBrush="White"
                BorderThickness="2">
                <ScrollViewer
                    Margin="5">
                    <TextBlock
                        Name="LogTextBox"></TextBlock>
                </ScrollViewer>
            </Border>
            <Button
                Name="BackButton"
                Grid.Row="2"
                IsEnabled="False"
                HorizontalAlignment="Center">Back</Button>
        </Grid>
    </Grid>
    
</Window>
