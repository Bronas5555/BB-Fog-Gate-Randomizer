<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:BB_Fog_Gate_Randomizer.UserControls"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
        x:Class="BB_Fog_Gate_Randomizer.MainWindow"
        Title="BB_Fog_Gate_Randomizer"
        Width="600"
        Height="800">
    <Grid
        RowDefinitions="Auto, *, Auto">
        <controls:TopToolBar
            Grid.Row="0"></controls:TopToolBar>
        <controls:RandomizerSettings
            Grid.Row="1"></controls:RandomizerSettings>
        <controls:RandomizerControllBar
            Grid.Row="2"></controls:RandomizerControllBar>
    </Grid>
</Window>
